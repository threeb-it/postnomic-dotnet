<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>Postnomic.Client.AspNetCore</PackageId>
    <Title>Postnomic Client for ASP.NET Core</Title>
    <Description>Razor Pages Area for rendering a Postnomic blog in ASP.NET Core MVC/Razor Pages applications. The blog URL is configurable via PostnomicClientOptions.BasePath (default: /blog).</Description>
    <PackageTags>postnomic;blog;cms;client;aspnetcore;razorpages</PackageTags>

    <!-- wwwroot/.gitkeep only exists to keep the content root directory tracked in git;
         it must never become a static web asset (dotnet pack excludes dotfiles from the
         nupkg by default, which would leave the asset referenced-but-absent and break
         consumers' publish with MSB3030). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\.gitkeep</DefaultItemExcludes>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Postnomic.Client\Postnomic.Client.csproj" />
    <ProjectReference Include="..\Postnomic.Client.Abstractions\Postnomic.Client.Abstractions.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\postnomic-blog.css" Link="wwwroot\postnomic-blog.css" />
  </ItemGroup>

</Project>
