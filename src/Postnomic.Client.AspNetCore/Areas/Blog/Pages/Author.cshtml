@page "{authorSlug}"
@model Postnomic.Client.AspNetCore.Areas.Blog.Pages.AuthorModel
@{
    ViewData["Title"] = Model.Profile.Name;
    var indexUrl = PostnomicRouteBuilder.BuildIndex(Model.BasePath, Model.RouteStyle, Model.Lang);
    var seoModel = PostnomicSeo.ForAuthor(Model.HttpContext.Request, Model);
}

@section PostnomicHead {
    <partial name="_SeoHead" model="seoModel" />
}

<div class="@(Model.Semantic ? Model.Cls.BlogRoot : "container py-4")">
    @if (!string.IsNullOrEmpty(Model.Profile.HeaderImageUrl))
    {
        <div class="mb-4">
            <img src="@Model.Profile.HeaderImageUrl"
                 class="w-100 rounded shadow-sm"
                 alt="@Model.Profile.Name header"
                 style="max-height: 300px; object-fit: cover;" />
        </div>
    }

    <div class="@(Model.Semantic ? Model.Cls.Layout : "row g-4")">
        <div class="@Model.Cls.Sidebar">
            <div class="@(Model.Semantic ? Model.Cls.Card : "card shadow-sm")">
                <div class="@(Model.Semantic ? $"{Model.Cls.CardBody} pn-text-center" : "card-body text-center")">
                    @if (!string.IsNullOrEmpty(Model.Profile.ProfileImageUrl))
                    {
                        <img src="@Model.Profile.ProfileImageUrl"
                             class="rounded-circle mb-3"
                             alt="@Model.Profile.Name"
                             style="width: 150px; height: 150px; object-fit: cover;" />
                    }
                    <h1 class="@(Model.Semantic ? Model.Cls.Title : "h4 fw-bold")">@Model.Profile.Name</h1>

                    @if (!string.IsNullOrEmpty(Model.Profile.Headline))
                    {
                        <p class="@(Model.Semantic ? Model.Cls.Lead : "text-muted")">@Model.Profile.Headline</p>
                    }

                    @if (!string.IsNullOrEmpty(Model.Profile.JobTitle) || !string.IsNullOrEmpty(Model.Profile.Company))
                    {
                        <p class="@(Model.Semantic ? "" : "text-muted small")">
                            @Model.Profile.JobTitle
                            @if (!string.IsNullOrEmpty(Model.Profile.JobTitle) && !string.IsNullOrEmpty(Model.Profile.Company))
                            {
                                <text> at </text>
                            }
                            @if (!string.IsNullOrEmpty(Model.Profile.Company))
                            {
                                <strong>@Model.Profile.Company</strong>
                            }
                        </p>
                    }

                    @if (!string.IsNullOrEmpty(Model.Profile.Location))
                    {
                        <p class="@(Model.Semantic ? "" : "text-muted small")">📍 @Model.Profile.Location</p>
                    }

                    @if (!string.IsNullOrEmpty(Model.Profile.WebsiteUrl))
                    {
                        <p>
                            <a href="@Model.Profile.WebsiteUrl" target="_blank" rel="noopener noreferrer"
                               class="@(Model.Semantic ? "" : "text-decoration-none")">🌐 Website</a>
                        </p>
                    }

                    <p class="@(Model.Semantic ? "" : "mb-0")">
                        <span class="@(Model.Semantic ? Model.Cls.TagCategory : "badge bg-primary")">@Model.Profile.PostCount post@(Model.Profile.PostCount == 1 ? "" : "s")</span>
                    </p>
                </div>
            </div>

            @if (Model.Profile.SocialLinks.Count > 0)
            {
                <div class="@(Model.Semantic ? Model.Cls.Widget : "card shadow-sm mt-3")">
                    <div class="@(Model.Semantic ? "" : "card-body")">
                        <h5 class="@(Model.Semantic ? Model.Cls.WidgetTitle : "card-title")">Connect</h5>
                        <div class="@(Model.Semantic ? "" : "d-flex flex-wrap gap-2")">
                            @foreach (var link in Model.Profile.SocialLinks)
                            {
                                <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                                   class="@(Model.Semantic ? Model.Cls.BtnOutline : "btn btn-outline-secondary btn-sm")">@link.Platform</a>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (Model.Profile.Skills.Count > 0)
            {
                <div class="@(Model.Semantic ? Model.Cls.Widget : "card shadow-sm mt-3")">
                    <div class="@(Model.Semantic ? "" : "card-body")">
                        <h5 class="@(Model.Semantic ? Model.Cls.WidgetTitle : "card-title")">Skills</h5>
                        <div class="@(Model.Semantic ? "" : "d-flex flex-wrap gap-1")">
                            @foreach (var skill in Model.Profile.Skills)
                            {
                                <span class="@(Model.Semantic ? Model.Cls.Tag : "badge bg-secondary")">@skill</span>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (Model.Profile.Languages.Count > 0)
            {
                <div class="@(Model.Semantic ? Model.Cls.Widget : "card shadow-sm mt-3")">
                    <div class="@(Model.Semantic ? "" : "card-body")">
                        <h5 class="@(Model.Semantic ? Model.Cls.WidgetTitle : "card-title")">Languages</h5>
                        <ul class="@(Model.Semantic ? "" : "list-unstyled mb-0")">
                            @foreach (var lang in Model.Profile.Languages)
                            {
                                <li>
                                    @lang.Name
                                    @if (!string.IsNullOrEmpty(lang.Proficiency))
                                    {
                                        <span class="@(Model.Semantic ? "" : "text-muted small")">— @lang.Proficiency</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            @if (Model.Profile.Interests.Count > 0)
            {
                <div class="@(Model.Semantic ? Model.Cls.Widget : "card shadow-sm mt-3")">
                    <div class="@(Model.Semantic ? "" : "card-body")">
                        <h5 class="@(Model.Semantic ? Model.Cls.WidgetTitle : "card-title")">Interests</h5>
                        <div class="@(Model.Semantic ? "" : "d-flex flex-wrap gap-1")">
                            @foreach (var interest in Model.Profile.Interests)
                            {
                                <span class="@(Model.Semantic ? Model.Cls.Tag : "badge bg-info text-dark")">@interest</span>
                            }
                        </div>
                    </div>
                </div>
            }

            @* Postnomic promotion (free tier) *@
            @if (Model.ShowBranding)
            {
                <div class="@(Model.Semantic ? $"{Model.Cls.Widget} pn-widget--promo" : "postnomic-sidebar-ad card mt-3 shadow-sm border-primary")" role="complementary">
                    <div class="@(Model.Semantic ? "" : "card-body text-center")">
                        <h5 class="@(Model.Semantic ? Model.Cls.WidgetTitle : "card-title fw-bold")">Postnomic</h5>
                        <p class="@(Model.Semantic ? "" : "card-text text-muted small")">
                            The developer-first headless blog platform. Add a full-featured blog to your app in minutes.
                        </p>
                        <a href="https://postnomic.com" target="_blank" rel="noopener noreferrer"
                           class="@(Model.Semantic ? Model.Cls.BtnPrimary : "btn btn-primary btn-sm mb-2 w-100")">Learn More</a>
                        <a href="https://postnomic.com/#pricing" target="_blank" rel="noopener noreferrer"
                           class="@(Model.Semantic ? Model.Cls.BtnOutline : "btn btn-outline-primary btn-sm w-100")">View Pricing</a>
                        <p class="@(Model.Semantic ? "" : "mt-2 mb-0")">
                            <small class="text-muted">
                                <a href="https://postnomic.com/#pricing" target="_blank" rel="noopener noreferrer"
                                   class="@(Model.Semantic ? "" : "text-decoration-none")">Upgrade to remove ads</a>
                            </small>
                        </p>
                    </div>
                </div>
            }
        </div>

        <div class="@Model.Cls.Main">
            @if (!string.IsNullOrEmpty(Model.Profile.Bio))
            {
                <div class="@(Model.Semantic ? Model.Cls.Card : "card shadow-sm mb-4")">
                    <div class="@Model.Cls.CardBody">
                        <h5 class="@(Model.Semantic ? Model.Cls.WidgetTitle : "card-title")">About</h5>
                        @Html.Raw(Model.Profile.Bio)
                    </div>
                </div>
            }

            @if (Model.Profile.Certifications.Count > 0)
            {
                <div class="@(Model.Semantic ? Model.Cls.Card : "card shadow-sm mb-4")">
                    <div class="@Model.Cls.CardBody">
                        <h5 class="@(Model.Semantic ? Model.Cls.WidgetTitle : "card-title")">Certifications</h5>
                        @foreach (var cert in Model.Profile.Certifications)
                        {
                            <div class="border-bottom py-2">
                                <strong>@cert.Name</strong>
                                @if (!string.IsNullOrEmpty(cert.IssuingOrganization))
                                {
                                    <br /><span class="text-muted small">@cert.IssuingOrganization</span>
                                }
                                @if (cert.IssueDate.HasValue)
                                {
                                    <br /><span class="text-muted small">
                                        Issued @cert.IssueDate.Value.ToString("MMM yyyy")
                                        @if (cert.ExpirationDate.HasValue)
                                        {
                                            <text> · Expires @cert.ExpirationDate.Value.ToString("MMM yyyy")</text>
                                        }
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(cert.CredentialUrl))
                                {
                                    <br />
                                    <a href="@cert.CredentialUrl" target="_blank" rel="noopener noreferrer"
                                       class="small text-decoration-none">View credential</a>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model.Profile.Education.Count > 0)
            {
                <div class="@(Model.Semantic ? Model.Cls.Card : "card shadow-sm mb-4")">
                    <div class="@Model.Cls.CardBody">
                        <h5 class="@(Model.Semantic ? Model.Cls.WidgetTitle : "card-title")">Education</h5>
                        @foreach (var edu in Model.Profile.Education)
                        {
                            <div class="border-bottom py-2">
                                <strong>@edu.Institution</strong>
                                @if (!string.IsNullOrEmpty(edu.Degree) || !string.IsNullOrEmpty(edu.FieldOfStudy))
                                {
                                    <br /><span class="text-muted small">
                                        @edu.Degree
                                        @if (!string.IsNullOrEmpty(edu.Degree) && !string.IsNullOrEmpty(edu.FieldOfStudy))
                                        {
                                            <text>, </text>
                                        }
                                        @edu.FieldOfStudy
                                    </span>
                                }
                                @if (edu.StartDate.HasValue)
                                {
                                    <br /><span class="text-muted small">
                                        @edu.StartDate.Value.ToString("yyyy")
                                        @if (edu.EndDate.HasValue)
                                        {
                                            <text> – @edu.EndDate.Value.ToString("yyyy")</text>
                                        }
                                        else
                                        {
                                            <text> – Present</text>
                                        }
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model.Profile.RecentPosts.Count > 0)
            {
                <div class="@(Model.Semantic ? Model.Cls.Card : "card shadow-sm mb-4")">
                    <div class="@Model.Cls.CardBody">
                        <h5 class="@(Model.Semantic ? Model.Cls.WidgetTitle : "card-title")">Recent Posts</h5>
                        @foreach (var post in Model.Profile.RecentPosts)
                        {
                            <div class="border-bottom py-2">
                                <a href="@PostnomicRouteBuilder.BuildPost(Model.BasePath, Model.RouteStyle, Model.Lang, post.Slug)"
                                   class="text-decoration-none fw-bold">@post.Title</a>
                                <br />
                                <span class="text-muted small">@post.PublishedAt.ToString("MMMM dd, yyyy")</span>
                                @if (!string.IsNullOrEmpty(post.Excerpt))
                                {
                                    <p class="text-muted small mt-1 mb-0">@post.Excerpt</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="mb-3">
                <a href="@indexUrl" class="@(Model.Semantic ? Model.Cls.BtnSm : "btn btn-outline-secondary btn-sm")">
                    &larr; Back to Blog
                </a>
            </div>
        </div>
    </div>
</div>
