@* Recursive partial view for rendering a single comment and its nested replies. *@
@* Invoke with: @await Html.PartialAsync("_Comment", comment) *@
@model Postnomic.Client.Abstractions.Models.PostnomicComment
@using Postnomic.Client.AspNetCore
@inject IPostnomicBlogResolver BlogResolver
@inject Microsoft.Extensions.Options.IOptions<PostnomicClientOptions> DefaultClientOptions
@inject Microsoft.Extensions.Options.IOptionsMonitor<PostnomicClientOptions> ClientOptionsMonitor
@{
    var blogName = BlogResolver.ResolveBlogName(ViewContext.HttpContext.Request.Path.Value ?? "");
    var markupStyle = blogName is not null
        ? ClientOptionsMonitor.Get(blogName).MarkupStyle
        : DefaultClientOptions.Value.MarkupStyle;
    var semantic = markupStyle == PostnomicMarkupStyle.Semantic;
    var cls = new PostnomicCssClasses(markupStyle);
}

<div class="@(semantic ? cls.Comment : "postnomic-comment border-start border-3 ps-3 mb-3")">
    <div class="@(semantic ? "" : "d-flex align-items-center gap-2 mb-1")">
        <span class="fw-semibold">@(Model.AuthorName ?? Localizer["CommentAnonymous"].Value)</span>
        <span class="text-muted small">@Model.CreatedAt.ToString("g", CultureInfo.CurrentCulture)</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Subject))
    {
        <p class="mb-1 fw-semibold text-secondary">@Model.Subject</p>
    }

    <p class="mb-2">@Model.Body</p>

    @if (Model.Replies.Count > 0)
    {
        <div class="postnomic-comment-replies ms-3 mt-2">
            @foreach (var reply in Model.Replies)
            {
                @await Html.PartialAsync("_Comment", reply)
            }
        </div>
    }
</div>
