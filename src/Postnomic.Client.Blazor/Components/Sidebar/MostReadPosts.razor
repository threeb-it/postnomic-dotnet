@inject IPostnomicBlogService _injectedBlogService
@inject IOptions<PostnomicClientOptions> _injectedClientOptions

<div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Widget : "card mb-4")">
    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "card-body")">
        <h5 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.WidgetTitle : "card-title fw-bold mb-3")">
            @Icon("bi bi-eye") @T("MostReadPosts.Title")
        </h5>
        @if (posts is null)
        {
            <p class="text-muted"><em>@T("Common.Loading")</em></p>
        }
        else if (posts.Count == 0)
        {
            <p class="text-muted small">@T("Common.NoPostsFound")</p>
        }
        else
        {
            <ul class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "list-group list-group-flush")">
                @foreach (var post in posts)
                {
                    <li class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "list-group-item px-0 d-flex justify-content-between align-items-start")">
                        <a href="@PostnomicRouteBuilder.BuildPost(BasePath, RouteStyle, Language, post.Slug)"
                           class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-decoration-none text-dark fw-semibold")">
                            @post.Title
                        </a>
                        <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Tag : "badge bg-primary rounded-pill ms-2")">
                            @post.Count.ToString("N0") @Icon("bi bi-eye-fill")
                        </span>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Optional ISO-639-1 language code (e.g. "de") for the current page, used together with
    /// <see cref="BasePath"/> and <see cref="RouteStyle"/> to build correctly language-routed
    /// post links. The host page (e.g. <c>PostPage</c>/<c>BlogPage</c>) supplies this from its
    /// own <c>Language</c> parameter.
    /// </summary>
    [Parameter]
    public string? Language { get; set; }

    [CascadingParameter]
    private PostnomicBlogContext? BlogContext { get; set; }

    private IPostnomicBlogService BlogService => BlogContext?.BlogService ?? _injectedBlogService;
    private string BasePath => BlogContext?.Options.BasePath ?? _injectedClientOptions.Value.BasePath;

    /// <summary>
    /// The <see cref="PostnomicLanguageRouteStyle"/> configured for this blog. Used together with
    /// <see cref="BasePath"/> and <see cref="Language"/> by <see cref="PostnomicRouteBuilder"/> to
    /// generate correct links regardless of style.
    /// </summary>
    private PostnomicLanguageRouteStyle RouteStyle => BlogContext?.Options.LanguageRouteStyle
        ?? _injectedClientOptions.Value.LanguageRouteStyle;

    private PostnomicMarkupStyle MarkupStyle =>
        BlogContext?.Options.MarkupStyle ?? _injectedClientOptions.Value.MarkupStyle;
    private PostnomicCssClasses Cls => new(MarkupStyle);

    /// <summary>
    /// Consumer-supplied overrides for the built-in UI chrome strings, if any. See
    /// <see cref="PostnomicUiStringOverrides"/>.
    /// </summary>
    private PostnomicUiStringOverrides? UiStringOverrides =>
        BlogContext?.Options.UiStrings ?? _injectedClientOptions.Value.UiStrings;

    /// <summary>Resolves a built-in UI chrome string key for this component's <see cref="Language"/>.</summary>
    private string T(string key) => PostnomicUiStrings.Get(key, Language, UiStringOverrides);

    private MarkupString Icon(string bootstrapIconClass) => (MarkupString)(
        MarkupStyle == PostnomicMarkupStyle.Semantic
            ? PostnomicIcons.Markup(bootstrapIconClass)
            : $"<i class=\"{bootstrapIconClass}\"></i>");

    private List<PostnomicPopularPost>? posts;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        try
        {
            posts = await BlogService.GetMostReadPostsAsync(count: 3);
        }
        catch
        {
            posts = [];
        }
    }
}
