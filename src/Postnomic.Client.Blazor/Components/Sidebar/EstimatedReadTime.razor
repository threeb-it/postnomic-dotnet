@using System.Text.RegularExpressions
@inject IOptions<PostnomicClientOptions> _injectedClientOptions

<div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Widget : "card mb-4")">
    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "card-body")">
        <h5 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.WidgetTitle : "card-title fw-bold mb-3")">
            @Icon("bi bi-clock") @T("EstimatedReadTime.Title")
        </h5>
        @if (string.IsNullOrWhiteSpace(PostContent))
        {
            <p class="text-muted small">@T("EstimatedReadTime.NoContent")</p>
        }
        else
        {
            <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "d-flex align-items-center gap-2")">
                <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "display-6 fw-bold text-primary")">@ReadTimeMinutes</span>
                <span class="text-muted">@Plural(ReadTimeMinutes, "EstimatedReadTime.Minute", "EstimatedReadTime.Minutes")</span>
            </div>
            <p class="text-muted small mb-0 mt-1">@WordCount.ToString("N0") @T("EstimatedReadTime.Words")</p>
        }
    </div>
</div>

@code {
    private const int WordsPerMinute = 200;

    /// <summary>
    /// The raw HTML content of the post used to estimate reading time.
    /// Pass <see langword="null"/> or an empty string when no content is available.
    /// </summary>
    [Parameter]
    public string? PostContent { get; set; }

    /// <summary>
    /// Optional ISO-639-1 language code (e.g. "de") used to select the UI chrome strings (title,
    /// "minute(s)", "words") rendered by this component. Null renders the English built-ins. The
    /// host page (e.g. <c>PostPage</c>) supplies this from its own <c>Language</c> parameter.
    /// </summary>
    [Parameter]
    public string? Language { get; set; }

    [CascadingParameter]
    private PostnomicBlogContext? BlogContext { get; set; }

    private PostnomicMarkupStyle MarkupStyle =>
        BlogContext?.Options.MarkupStyle ?? _injectedClientOptions.Value.MarkupStyle;
    private PostnomicCssClasses Cls => new(MarkupStyle);

    /// <summary>
    /// Consumer-supplied overrides for the built-in UI chrome strings, if any. See
    /// <see cref="PostnomicUiStringOverrides"/>.
    /// </summary>
    private PostnomicUiStringOverrides? UiStringOverrides =>
        BlogContext?.Options.UiStrings ?? _injectedClientOptions.Value.UiStrings;

    /// <summary>Resolves a built-in UI chrome string key for this component's <see cref="Language"/>.</summary>
    private string T(string key) => PostnomicUiStrings.Get(key, Language, UiStringOverrides);

    /// <summary>Resolves the singular or plural UI chrome string key for <paramref name="count"/>.</summary>
    private string Plural(int count, string singularKey, string pluralKey) =>
        PostnomicUiStrings.Pluralize(count, singularKey, pluralKey, Language, UiStringOverrides);

    private MarkupString Icon(string bootstrapIconClass) => (MarkupString)(
        MarkupStyle == PostnomicMarkupStyle.Semantic
            ? PostnomicIcons.Markup(bootstrapIconClass)
            : $"<i class=\"{bootstrapIconClass}\"></i>");

    private int WordCount => CountWords(PostContent);

    private int ReadTimeMinutes => Math.Max(1, (int)Math.Ceiling(WordCount / (double)WordsPerMinute));

    private static int CountWords(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return 0;

        var text = Regex.Replace(html, "<[^>]+>", " ");
        text = System.Net.WebUtility.HtmlDecode(text);
        var words = text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
        return words.Length;
    }
}
