@inject IOptions<PostnomicClientOptions> _injectedClientOptions

@if (Visible)
{
    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? $"{Cls.Widget} pn-widget--promo" : "postnomic-sidebar-ad card mb-4 shadow-sm border-primary")" role="complementary">
        <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "card-body text-center")">
            <h5 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.WidgetTitle : "card-title fw-bold")">Postnomic</h5>
            <p class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "card-text text-muted small")">
                The developer-first headless blog platform. Add a full-featured blog to your app in minutes.
            </p>
            <a href="https://postnomic.com" target="_blank" rel="noopener noreferrer"
               class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.BtnPrimary : "btn btn-primary btn-sm mb-2 w-100")">Learn More</a>
            <a href="https://postnomic.com/#pricing" target="_blank" rel="noopener noreferrer"
               class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.BtnOutline : "btn btn-outline-primary btn-sm w-100")">View Pricing</a>
            <p class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mt-2 mb-0")">
                <small class="text-muted">
                    <a href="https://postnomic.com/#pricing" target="_blank" rel="noopener noreferrer"
                       class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-decoration-none")">Upgrade to remove ads</a>
                </small>
            </p>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    [CascadingParameter]
    private PostnomicBlogContext? BlogContext { get; set; }

    private PostnomicMarkupStyle MarkupStyle =>
        BlogContext?.Options.MarkupStyle ?? _injectedClientOptions.Value.MarkupStyle;
    private PostnomicCssClasses Cls => new(MarkupStyle);
}
