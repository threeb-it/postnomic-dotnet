@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@inject IServiceProvider ServiceProvider
@inject ILogger<PostnomicBlogScope> Logger

<CascadingValue Value="context" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    /// <summary>
    /// The registered name of the blog to scope. Must match the name passed to
    /// <c>AddPostnomicBlog(string name, ...)</c> during service registration.
    /// </summary>
    [Parameter, EditorRequired]
    public string BlogName { get; set; } = "";

    /// <summary>
    /// The child content that will receive the scoped blog service via cascading parameter.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private PostnomicBlogContext? context;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // Resolve the keyed blog service without GetRequiredKeyedService so a missing registration
        // produces an actionable message instead of the framework's opaque
        // "No keyed service for type 'IPostnomicBlogService' ... has been registered" crash.
        var service = ServiceProvider.GetKeyedService<IPostnomicBlogService>(BlogName);
        if (service is null)
        {
            Logger.LogError(
                "PostnomicBlogScope could not resolve a blog registered under the name '{BlogName}'. "
                + "Register it with AddPostnomicBlog(\"{BlogName}\", ...) and ensure the "
                + "PostnomicBlogScope BlogName parameter matches that name exactly.",
                BlogName, BlogName);
            throw new InvalidOperationException(
                $"No Postnomic blog is registered under the name '{BlogName}'. Register it with "
                + $"AddPostnomicBlog(\"{BlogName}\", options => ...) during service configuration, and "
                + $"ensure the PostnomicBlogScope BlogName parameter matches that name exactly.");
        }

        var monitor = ServiceProvider.GetRequiredService<IOptionsMonitor<PostnomicClientOptions>>();
        context = new PostnomicBlogContext
        {
            BlogName = BlogName,
            BlogService = service,
            Options = monitor.Get(BlogName)
        };
    }
}
