@using Postnomic.Client.Blazor.Components.Sidebar
@inject IPostnomicBlogService _injectedBlogService
@inject NavigationManager Navigation
@inject IOptions<PostnomicClientOptions> _injectedClientOptions
@implements IDisposable

<PageTitle>@(post?.Title ?? "Post")</PageTitle>
<PostnomicSeoHead Model="Seo" />

@if (MarkupStyle != PostnomicMarkupStyle.Semantic)
{
<style>
    .blog-post-content img {
        max-width: 100%;
        height: auto;
        display: block;
        margin-left: auto;
        margin-right: auto;
    }
</style>
}

<div class="@Cls.BlogRoot">
    @if (post is null)
    {
        <div class="@Cls.Loading">
            <p><em>@T("Common.Loading")</em></p>
        </div>
    }
    else
    {
        <div class="@Cls.Layout">
            <div class="@Cls.Main">
                <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mb-3")">
                    <a href="@PostnomicRouteBuilder.BuildIndex(BasePath, RouteStyle, Language)" class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-decoration-none")">
                        @T("Common.BackToBlog")
                    </a>
                </div>

                <article>
                    @if (!string.IsNullOrEmpty(post.CoverImageUrl))
                    {
                        <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-center mb-4")">
                            <img src="@post.CoverImageUrl"
                                 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.CardMedia : "img-fluid rounded shadow-sm")"
                                 alt="@post.Title"
                                 style="max-width: 100%; max-height: 450px; object-fit: cover;" />
                        </div>
                    }

                    <h1 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.PostTitle : "display-6 fw-bold mb-3")">@post.Title</h1>

                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.PostMeta : "text-muted mb-3 border-bottom pb-3")">
                        <span>
                            @Icon("bi bi-person")
                            @if (!string.IsNullOrEmpty(post.AuthorSlug))
                            {
                                <a href="@PostnomicRouteBuilder.BuildAuthor(BasePath, RouteStyle, Language, post.AuthorSlug)" class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-decoration-none")">@post.AuthorName</a>
                            }
                            else
                            {
                                @post.AuthorName
                            }
                        </span>
                        <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mx-2")">·</span>
                        <span>
                            @Icon("bi bi-calendar") @PostnomicDateFormatter.LongDate(post.PublishedAt, Language)
                        </span>
                    </div>

                    @if (post.Tags.Count > 0)
                    {
                        <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mb-3")">
                            @foreach (var tag in post.Tags)
                            {
                                <span class="@Cls.Tag">@tag.Name</span>
                            }
                        </div>
                    }

                    @if (post.Categories.Count > 0)
                    {
                        <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mb-3")">
                            @foreach (var category in post.Categories)
                            {
                                <span class="@Cls.TagCategory">@category.Name</span>
                            }
                        </div>
                    }

                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.PostContent : "blog-post-content mb-5")" style="overflow-wrap: break-word; word-break: break-word;">
                        @((MarkupString)(post.Content ?? ""))
                    </div>
                </article>

                @if (ShowBranding)
                {
                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "postnomic-branding alert alert-light border text-center py-3 mt-4")" role="complementary">
                        <small class="text-muted">
                            @T("PostPage.PoweredBy") <a href="https://postnomic.com" target="_blank" rel="noopener noreferrer" class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "fw-semibold text-decoration-none")">Postnomic</a>
                            @T("PostPage.TaglineSuffix")
                            <a href="https://postnomic.com/#pricing" target="_blank" rel="noopener noreferrer" class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-decoration-none")">@T("PostPage.UpgradeToRemoveBanner")</a>
                        </small>
                    </div>
                }

                <hr />

                <section class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "comments-section mt-4 mb-5")">
                    <h3 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mb-4")">
                        @TF("PostPage.CommentsHeading", post.Comments.Count)
                    </h3>

                    @if (post.Comments.Count == 0)
                    {
                        <p class="text-muted">@T("PostPage.NoCommentsYet")</p>
                    }
                    else
                    {
                        @foreach (var comment in post.Comments)
                        {
                            <CommentView Comment="comment"
                                         Depth="0"
                                         PostSlug="@PostSlug"
                                         Post="post"
                                         Language="@Language"
                                         OnCommentPosted="HandleCommentPostedAsync" />
                        }
                    }

                    @if (post.CommentsEnabled)
                    {
                        <hr class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "my-4")" />
                        <h4 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mb-3")">@T("PostPage.LeaveAComment")</h4>

                        @if (!string.IsNullOrEmpty(commentSuccessMessage))
                        {
                            <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "pn-alert pn-alert--success" : "alert alert-success")">@commentSuccessMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(commentErrorMessage))
                        {
                            <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "pn-alert pn-alert--danger" : "alert alert-danger")">@commentErrorMessage</div>
                        }

                        <EditForm Model="newComment" OnValidSubmit="SubmitCommentAsync" FormName="newTopLevelComment">
                            <DataAnnotationsValidator />

                            <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "pn-form-row" : "row")">
                                <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "col-md-6 mb-3")">
                                    <label class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "form-label")">
                                        @T("Common.Form.FirstName") @if (post.CommentRequireFirstname) { <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "pn-required" : "text-danger")">*</span> }
                                    </label>
                                    <InputText @bind-Value="newComment.AuthorFirstname" class="@Cls.Field" />
                                </div>
                                <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "col-md-6 mb-3")">
                                    <label class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "form-label")">
                                        @T("Common.Form.LastName") @if (post.CommentRequireLastname) { <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "pn-required" : "text-danger")">*</span> }
                                    </label>
                                    <InputText @bind-Value="newComment.AuthorLastname" class="@Cls.Field" />
                                </div>
                            </div>

                            <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "pn-form-row" : "row")">
                                <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "col-md-6 mb-3")">
                                    <label class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "form-label")">
                                        @T("Common.Form.Email") @if (post.CommentRequireEmail) { <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "pn-required" : "text-danger")">*</span> }
                                    </label>
                                    <InputText @bind-Value="newComment.AuthorEmail" class="@Cls.Field" type="email" />
                                </div>
                                <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "col-md-6 mb-3")">
                                    <label class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "form-label")">
                                        @T("Common.Form.Phone") @if (post.CommentRequirePhone) { <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "pn-required" : "text-danger")">*</span> }
                                    </label>
                                    <InputText @bind-Value="newComment.AuthorPhone" class="@Cls.Field" type="tel" />
                                </div>
                            </div>

                            <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mb-3")">
                                <label class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "form-label")">
                                    @T("Common.Form.Subject") @if (post.CommentRequireSubject) { <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "pn-required" : "text-danger")">*</span> }
                                </label>
                                <InputText @bind-Value="newComment.Subject" class="@Cls.Field" />
                            </div>

                            <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mb-3")">
                                <label class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "form-label")">@T("PostPage.Form.CommentLabel") <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "pn-required" : "text-danger")">*</span></label>
                                <InputTextArea @bind-Value="newComment.Body" class="@Cls.Field" rows="4" />
                            </div>

                            <button type="submit" class="@Cls.BtnPrimary" disabled="@isSubmitting">
                                @(isSubmitting ? T("Common.Submitting") : T("PostPage.PostComment"))
                            </button>
                        </EditForm>
                    }
                    else
                    {
                        <p class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "text-muted" : "text-muted fst-italic mt-3")">@T("PostPage.CommentsClosed")</p>
                    }
                </section>
            </div>

            @* ── Right sidebar ── *@
            <div class="@Cls.Sidebar">
                <EstimatedReadTime PostContent="@post.Content" Language="@Language" />
                <TopCommentedPosts Language="@Language" />
                <MostReadPosts Language="@Language" />

                <PostnomicPromo Visible="ShowBranding" Language="@Language" />
            </div>
        </div>
    }
</div>

@code {
    /// <summary>The URL-friendly slug of the post to display.</summary>
    [Parameter]
    public string PostSlug { get; set; } = "";

    /// <summary>
    /// Optional ISO-639-1 language code (e.g. "de") used to fetch a translated version of the
    /// post. Null serves the blog's default language. The host application supplies this from
    /// its own route (e.g. <c>/blog/{Language}/post/{PostSlug}</c>).
    /// </summary>
    [Parameter]
    public string? Language { get; set; }

    private PostnomicPostDetail? post;
    private PostnomicBlogInfo? blogInfo;
    private CommentFormModel newComment = new();
    private bool isSubmitting;
    private string? commentSuccessMessage;
    private string? commentErrorMessage;

    private readonly string sessionId = Guid.NewGuid().ToString("N");
    private DateTime pageOpenedAt;
    private System.Threading.Timer? readDurationTimer;

    [CascadingParameter]
    private PostnomicBlogContext? BlogContext { get; set; }

    private IPostnomicBlogService BlogService => BlogContext?.BlogService ?? _injectedBlogService;
    private string BasePath => BlogContext?.Options.BasePath ?? _injectedClientOptions.Value.BasePath;

    /// <summary>
    /// The <see cref="PostnomicLanguageRouteStyle"/> configured for this blog. Used together with
    /// <see cref="BasePath"/> and <see cref="Language"/> by <see cref="PostnomicRouteBuilder"/> to
    /// generate correct links regardless of style.
    /// </summary>
    private PostnomicLanguageRouteStyle RouteStyle => BlogContext?.Options.LanguageRouteStyle
        ?? _injectedClientOptions.Value.LanguageRouteStyle;

    private PostnomicMarkupStyle MarkupStyle =>
        BlogContext?.Options.MarkupStyle ?? _injectedClientOptions.Value.MarkupStyle;
    private PostnomicCssClasses Cls => new(MarkupStyle);

    /// <summary>
    /// Consumer-supplied overrides for the built-in UI chrome strings, if any. See
    /// <see cref="PostnomicUiStringOverrides"/>.
    /// </summary>
    private PostnomicUiStringOverrides? UiStringOverrides =>
        BlogContext?.Options.UiStrings ?? _injectedClientOptions.Value.UiStrings;

    /// <summary>Resolves a built-in UI chrome string key for this page's <see cref="Language"/>.</summary>
    private string T(string key) => PostnomicUiStrings.Get(key, Language, UiStringOverrides);

    /// <summary>Resolves and formats a composite-format UI chrome string key (e.g. <c>"Comments ({0})"</c>).</summary>
    private string TF(string key, params object?[] args) => PostnomicUiStrings.GetFormat(key, Language, UiStringOverrides, args);

    private MarkupString Icon(string bootstrapIconClass) => (MarkupString)(
        MarkupStyle == PostnomicMarkupStyle.Semantic
            ? PostnomicIcons.Markup(bootstrapIconClass)
            : $"<i class=\"{bootstrapIconClass}\"></i>");

    private bool ShowBranding => blogInfo?.ShowBranding
        ?? BlogContext?.Options.ShowBranding
        ?? _injectedClientOptions.Value.ShowBranding;

    /// <summary>The SEO data for this post, or <see langword="null"/> until the post has loaded.</summary>
    private PostnomicSeoModel? Seo => post is null
        ? null
        : PostnomicSeoBuilder.ForPost(Navigation.BaseUri, BasePath, RouteStyle, Language, PostSlug, post, blogInfo);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        pageOpenedAt = DateTime.UtcNow;
        await LoadPostAsync();
        _ = TrackPageViewAsync();

        readDurationTimer = new System.Threading.Timer(
            _ => _ = ReportReadDurationAsync(),
            null,
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));
    }

    /// <inheritdoc />
    public void Dispose()
    {
        readDurationTimer?.Dispose();
        _ = ReportReadDurationAsync();
    }

    private async Task TrackPageViewAsync()
    {
        try
        {
            await BlogService.RecordPageViewAsync(
                sessionId: sessionId,
                postSlug: PostSlug);
        }
        catch
        {
            // Analytics is best-effort.
        }
    }

    private async Task ReportReadDurationAsync()
    {
        try
        {
            var duration = (int)(DateTime.UtcNow - pageOpenedAt).TotalSeconds;
            if (duration < 1) return;

            await BlogService.UpdateReadDurationAsync(
                sessionId: sessionId,
                durationSeconds: duration);
        }
        catch
        {
            // Analytics is best-effort.
        }
    }

    private async Task LoadPostAsync()
    {
        try
        {
            var postTask = BlogService.GetPostAsync(PostSlug, language: Language);
            var blogInfoTask = BlogService.GetBlogAsync();
            await Task.WhenAll(postTask, blogInfoTask);
            post = await postTask;
            blogInfo = await blogInfoTask;
        }
        catch
        {
            post = null;
            blogInfo = null;
        }
    }

    private async Task SubmitCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(newComment.Body)) return;

        isSubmitting = true;
        commentSuccessMessage = null;
        commentErrorMessage = null;

        try
        {
            var request = new PostnomicCreateCommentRequest
            {
                Subject = newComment.Subject,
                Body = newComment.Body!,
                AuthorFirstname = newComment.AuthorFirstname,
                AuthorLastname = newComment.AuthorLastname,
                AuthorEmail = newComment.AuthorEmail,
                AuthorPhone = newComment.AuthorPhone
            };

            var result = await BlogService.CreateCommentAsync(PostSlug, request);

            if (result is not null)
            {
                newComment = new CommentFormModel();

                commentSuccessMessage = post?.CommentRequireModeration == true
                    ? T("PostPage.CommentPostedModeration")
                    : T("PostPage.CommentPosted");

                await LoadPostAsync();
            }
            else
            {
                commentErrorMessage = T("PostPage.CommentPostFailed");
            }
        }
        catch (Exception ex)
        {
            commentErrorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleCommentPostedAsync()
    {
        await LoadPostAsync();
    }

    /// <summary>
    /// Internal model bound to the top-level comment form.
    /// </summary>
    private class CommentFormModel
    {
        public string? Subject { get; set; }
        public string? Body { get; set; }
        public string? AuthorFirstname { get; set; }
        public string? AuthorLastname { get; set; }
        public string? AuthorEmail { get; set; }
        public string? AuthorPhone { get; set; }
    }
}
