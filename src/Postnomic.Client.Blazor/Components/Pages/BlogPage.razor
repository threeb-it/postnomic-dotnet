@using Postnomic.Client.Blazor.Components.Sidebar
@inject IPostnomicBlogService _injectedBlogService
@inject NavigationManager Navigation
@inject IOptions<PostnomicClientOptions> _injectedClientOptions

<PageTitle>@(blog?.Name ?? "Blog")</PageTitle>
<PostnomicSeoHead Model="Seo" />

@if (MarkupStyle != PostnomicMarkupStyle.Semantic)
{
<style>
    .blog-container img {
        max-width: 100%;
        height: auto;
    }

    .postnomic-masonry {
        column-count: 2;
        column-gap: 1.5rem;
    }

    .postnomic-masonry > article {
        break-inside: avoid;
        margin-bottom: 1.5rem;
    }

    @@media (max-width: 768px) {
        .postnomic-masonry {
            column-count: 1;
        }
    }
</style>
}

<div class="@Cls.BlogRoot">
    <div class="@Cls.Header">
        @if (blog is not null)
        {
            <h1 class="@Cls.Title">@blog.Name</h1>
            @if (!string.IsNullOrEmpty(blog.Description))
            {
                <p class="@Cls.Lead">@blog.Description</p>
            }
        }
        else
        {
            <p><em>Loading…</em></p>
        }
    </div>

    <div class="@Cls.Layout">
        @* ── Main content column ── *@
        <div class="@Cls.Main">
            @if (HasActiveFilter)
            {
                <div class="@Cls.FilterBanner">
                    <span>
                        @Icon("bi bi-funnel") Filtered by: <strong>@ActiveFilterLabel</strong>
                    </span>
                    <button class="@Cls.BtnSm" @onclick="ClearAllFiltersAsync">
                        &#10005; Clear all
                    </button>
                </div>
            }

            @if (pagedPosts is not null)
            {
                @if (pagedPosts.Items.Count == 0)
                {
                    <div class="@Cls.Empty">
                        <p>No posts found.</p>
                    </div>
                }
                else
                {
                    <div class="@(IsMasonry ? Cls.Masonry : "")">
                    @foreach (var post in pagedPosts.Items)
                    {
                        <article class="@Cls.Card">
                            @if (!string.IsNullOrEmpty(post.ThumbnailImageUrl))
                            {
                                <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-center overflow-hidden")">
                                    <img src="@post.ThumbnailImageUrl"
                                         class="@Cls.CardMedia"
                                         alt="@post.Title"
                                         style="max-width: 100%; max-height: 300px; object-fit: cover;" />
                                </div>
                            }
                            <div class="@Cls.CardBody">
                                <h2 class="@Cls.PostTitle">
                                    <a href="@PostnomicRouteBuilder.BuildPost(BasePath, RouteStyle, Language, post.Slug)"
                                       class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-decoration-none text-dark")">
                                        @post.Title
                                    </a>
                                </h2>
                                <div class="@Cls.PostMeta">
                                    <span>
                                        @Icon("bi bi-person")
                                        @if (!string.IsNullOrEmpty(post.AuthorSlug))
                                        {
                                            <a href="@PostnomicRouteBuilder.BuildAuthor(BasePath, RouteStyle, Language, post.AuthorSlug)" class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-decoration-none")">@post.AuthorName</a>
                                        }
                                        else
                                        {
                                            @post.AuthorName
                                        }
                                    </span>
                                    <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mx-2")">·</span>
                                    <span>
                                        @Icon("bi bi-calendar") @post.PublishedAt.ToString("MMMM dd, yyyy")
                                    </span>
                                    <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mx-2")">·</span>
                                    <span>
                                        @Icon("bi bi-chat") @post.CommentCount @(post.CommentCount == 1 ? "comment" : "comments")
                                    </span>
                                </div>
                                @if (post.Tags.Count > 0)
                                {
                                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mb-2")">
                                        @foreach (var tag in post.Tags)
                                        {
                                            <span class="@Cls.Tag">@tag.Name</span>
                                        }
                                    </div>
                                }
                                @if (post.Categories.Count > 0)
                                {
                                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mb-2")">
                                        @foreach (var category in post.Categories)
                                        {
                                            <span class="@Cls.TagCategory">@category.Name</span>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(post.Excerpt))
                                {
                                    <p class="@Cls.Excerpt">@post.Excerpt</p>
                                }
                                <a href="@PostnomicRouteBuilder.BuildPost(BasePath, RouteStyle, Language, post.Slug)"
                                   class="@Cls.BtnOutline">
                                    Read More →
                                </a>
                            </div>
                        </article>
                    }
                    </div>

                    @if (pagedPosts.TotalPages > 1)
                    {
                        <nav aria-label="Blog pagination" class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "d-flex justify-content-center mb-4")">
                            <ul class="@Cls.Pagination">
                                <li class="@Cls.Page @(currentPage <= 1 ? Cls.PageDisabled : "")">
                                    <button class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "page-link")"
                                            @onclick="() => GoToPageAsync(currentPage - 1)"
                                            disabled="@(currentPage <= 1)">
                                        ← Previous
                                    </button>
                                </li>
                                @for (int i = 1; i <= pagedPosts.TotalPages; i++)
                                {
                                    var pageNum = i;
                                    <li class="@Cls.Page @(pageNum == currentPage ? Cls.PageActive : "")">
                                        <button class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "page-link")" @onclick="() => GoToPageAsync(pageNum)">
                                            @pageNum
                                        </button>
                                    </li>
                                }
                                <li class="@Cls.Page @(currentPage >= pagedPosts.TotalPages ? Cls.PageDisabled : "")">
                                    <button class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "page-link")"
                                            @onclick="() => GoToPageAsync(currentPage + 1)"
                                            disabled="@(currentPage >= pagedPosts.TotalPages)">
                                        Next →
                                    </button>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            }
            else
            {
                <div class="@Cls.Loading">
                    <p><em>Loading posts…</em></p>
                </div>
            }
        </div>

        @* ── Right sidebar ── *@
        <div class="@Cls.Sidebar">
            <SearchBox ActiveSearchTerm="@filterSearch"
                       OnFilterChanged="OnSearchChangedAsync" />

            <TagCloud ActiveTagSlug="@filterTag"
                      OnFilterChanged="OnTagFilterChangedAsync" />

            <CategoryList ActiveCategorySlug="@filterCategory"
                          OnFilterChanged="OnCategoryFilterChangedAsync" />

            <AuthorList ActiveAuthorName="@filterAuthor"
                        OnFilterChanged="OnAuthorFilterChangedAsync" />

            <TopCommentedPosts Language="@Language" />

            <MostReadPosts Language="@Language" />

            <PostnomicPromo Visible="ShowBranding" />
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Optional ISO-639-1 language code (e.g. "de") used to fetch translated posts. Null serves
    /// the blog's default language. The host application supplies this from its own route
    /// (e.g. <c>/blog/{Language}</c>).
    /// </summary>
    [Parameter]
    public string? Language { get; set; }

    private PostnomicBlogInfo? blog;
    private PostnomicPagedResult<PostnomicPostSummary>? pagedPosts;
    private int currentPage = 1;
    private const int PageSize = 5;

    private string? filterTag;
    private string? filterCategory;
    private string? filterAuthor;
    private string? filterSearch;

    [CascadingParameter]
    private PostnomicBlogContext? BlogContext { get; set; }

    private IPostnomicBlogService BlogService => BlogContext?.BlogService ?? _injectedBlogService;
    private string BasePath => BlogContext?.Options.BasePath ?? _injectedClientOptions.Value.BasePath;

    /// <summary>
    /// The <see cref="PostnomicLanguageRouteStyle"/> configured for this blog. Used together with
    /// <see cref="BasePath"/> and <see cref="Language"/> by <see cref="PostnomicRouteBuilder"/> to
    /// generate correct links regardless of style.
    /// </summary>
    private PostnomicLanguageRouteStyle RouteStyle => BlogContext?.Options.LanguageRouteStyle
        ?? _injectedClientOptions.Value.LanguageRouteStyle;

    private PostnomicMarkupStyle MarkupStyle =>
        BlogContext?.Options.MarkupStyle ?? _injectedClientOptions.Value.MarkupStyle;
    private PostnomicCssClasses Cls => new(MarkupStyle);

    /// <summary>
    /// Renders a small marker icon: a Bootstrap Icons <c>&lt;i&gt;</c> in Bootstrap mode, or a
    /// generic inline <c>&lt;svg&gt;</c> in Semantic mode (which carries no framework CSS
    /// dependency). Kept as a single inline expression (rather than a multi-line <c>@@if</c>) so
    /// call sites can sit on the same source line as surrounding text without Razor's whitespace
    /// trimming around code blocks swallowing the adjoining space.
    /// </summary>
    private MarkupString Icon(string bootstrapIconClass) => (MarkupString)(
        MarkupStyle == PostnomicMarkupStyle.Semantic
            ? "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><circle cx=\"8\" cy=\"8\" r=\"6\" /></svg>"
            : $"<i class=\"{bootstrapIconClass}\"></i>");

    /// <summary>The SEO data for the blog index, or <see langword="null"/> until the blog has loaded.</summary>
    private PostnomicSeoModel? Seo => blog is null
        ? null
        : PostnomicSeoBuilder.ForIndex(Navigation.BaseUri, BasePath, RouteStyle, Language, blog, pagedPosts?.Items ?? []);

    private bool IsMasonry => string.Equals(blog?.DefaultLayout, "Masonry", StringComparison.OrdinalIgnoreCase);

    private bool ShowBranding => blog?.ShowBranding
        ?? BlogContext?.Options.ShowBranding
        ?? _injectedClientOptions.Value.ShowBranding;

    private bool HasActiveFilter =>
        !string.IsNullOrEmpty(filterTag) ||
        !string.IsNullOrEmpty(filterCategory) ||
        !string.IsNullOrEmpty(filterAuthor) ||
        !string.IsNullOrEmpty(filterSearch);

    private string ActiveFilterLabel
    {
        get
        {
            if (!string.IsNullOrEmpty(filterSearch)) return $"\"{filterSearch}\"";
            if (!string.IsNullOrEmpty(filterTag)) return filterTag;
            if (!string.IsNullOrEmpty(filterCategory)) return filterCategory;
            if (!string.IsNullOrEmpty(filterAuthor)) return filterAuthor;
            return "";
        }
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await LoadBlogAsync();
        await LoadPostsAsync();
        _ = TrackPageViewAsync();
    }

    private async Task TrackPageViewAsync()
    {
        try
        {
            await BlogService.RecordPageViewAsync(
                sessionId: Guid.NewGuid().ToString("N"),
                postSlug: null);
        }
        catch
        {
            // Analytics is best-effort; do not break the page if it fails.
        }
    }

    private async Task LoadBlogAsync()
    {
        try
        {
            blog = await BlogService.GetBlogAsync();
        }
        catch
        {
            blog = null;
        }
    }

    private async Task LoadPostsAsync()
    {
        try
        {
            pagedPosts = await BlogService.GetPostsAsync(
                page: currentPage,
                pageSize: PageSize,
                tag: filterTag,
                category: filterCategory,
                author: filterAuthor,
                search: filterSearch,
                language: Language);
        }
        catch
        {
            pagedPosts = new PostnomicPagedResult<PostnomicPostSummary>
            {
                Items = [],
                Page = currentPage,
                PageSize = PageSize,
                TotalCount = 0,
                TotalPages = 0
            };
        }
    }

    private async Task GoToPageAsync(int page)
    {
        currentPage = page;
        await LoadPostsAsync();
    }

    private async Task ApplyFilterAndReloadAsync()
    {
        currentPage = 1;
        await LoadPostsAsync();
    }

    private async Task OnTagFilterChangedAsync(string? slug)
    {
        filterTag = slug;
        await ApplyFilterAndReloadAsync();
    }

    private async Task OnCategoryFilterChangedAsync(string? slug)
    {
        filterCategory = slug;
        await ApplyFilterAndReloadAsync();
    }

    private async Task OnAuthorFilterChangedAsync(string? name)
    {
        filterAuthor = name;
        await ApplyFilterAndReloadAsync();
    }

    private async Task OnSearchChangedAsync(string? term)
    {
        filterSearch = term;
        await ApplyFilterAndReloadAsync();
    }

    private async Task ClearAllFiltersAsync()
    {
        filterTag = null;
        filterCategory = null;
        filterAuthor = null;
        filterSearch = null;
        await ApplyFilterAndReloadAsync();
    }
}
