@using Postnomic.Client.Abstractions
@using Postnomic.Client.Abstractions.Models
@using Microsoft.Extensions.Options
@inject IPostnomicBlogService _injectedBlogService
@inject NavigationManager Navigation
@inject IOptions<PostnomicClientOptions> _injectedClientOptions

<PageTitle>@(profile?.Name ?? "Author")</PageTitle>
<PostnomicSeoHead Model="Seo" />

<div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.BlogRoot : "author-profile-container")">
    @if (profile is null)
    {
        <div class="text-center py-5">
            <p><em>Loading…</em></p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(profile.HeaderImageUrl))
        {
            <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mb-4")">
                <img src="@profile.HeaderImageUrl"
                     class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "w-100 rounded shadow-sm")"
                     alt="@profile.Name header"
                     style="max-height: 300px; object-fit: cover;" />
            </div>
        }

        <div class="@Cls.Layout">
            <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Sidebar : "col-lg-4 mb-4")">
                <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Card : "card shadow-sm")">
                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? $"{Cls.CardBody} pn-text-center" : "card-body text-center")">
                        @if (!string.IsNullOrEmpty(profile.ProfileImageUrl))
                        {
                            <img src="@profile.ProfileImageUrl"
                                 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "rounded-circle mb-3")"
                                 alt="@profile.Name"
                                 style="width: 150px; height: 150px; object-fit: cover;" />
                        }
                        <h1 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Title : "h4 fw-bold")">@profile.Name</h1>

                        @if (!string.IsNullOrEmpty(profile.Headline))
                        {
                            <p class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Lead : "text-muted")">@profile.Headline</p>
                        }

                        @if (!string.IsNullOrEmpty(profile.JobTitle) || !string.IsNullOrEmpty(profile.Company))
                        {
                            <p class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-muted small")">
                                @if (!string.IsNullOrEmpty(profile.JobTitle))
                                {
                                    <span>@profile.JobTitle</span>
                                }
                                @if (!string.IsNullOrEmpty(profile.JobTitle) && !string.IsNullOrEmpty(profile.Company))
                                {
                                    <span> at </span>
                                }
                                @if (!string.IsNullOrEmpty(profile.Company))
                                {
                                    <strong>@profile.Company</strong>
                                }
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(profile.Location))
                        {
                            <p class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-muted small")">
                                @Icon("bi bi-geo-alt") @profile.Location
                            </p>
                        }

                        @if (!string.IsNullOrEmpty(profile.WebsiteUrl))
                        {
                            <p>
                                <a href="@profile.WebsiteUrl" target="_blank" rel="noopener noreferrer"
                                   class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-decoration-none")">
                                    @Icon("bi bi-globe") Website
                                </a>
                            </p>
                        }

                        <p class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mb-0")">
                            <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.TagCategory : "badge bg-primary")">@profile.PostCount post@(profile.PostCount == 1 ? "" : "s")</span>
                        </p>
                    </div>
                </div>

                @if (profile.SocialLinks.Count > 0)
                {
                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Widget : "card shadow-sm mt-3")">
                        <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "card-body")">
                            <h5 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.WidgetTitle : "card-title")">Connect</h5>
                            <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "d-flex flex-wrap gap-2")">
                                @foreach (var link in profile.SocialLinks)
                                {
                                    <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                                       class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.BtnOutline : "btn btn-outline-secondary btn-sm")">
                                        @link.Platform
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (profile.Skills.Count > 0)
                {
                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Widget : "card shadow-sm mt-3")">
                        <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "card-body")">
                            <h5 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.WidgetTitle : "card-title")">Skills</h5>
                            <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "d-flex flex-wrap gap-1")">
                                @foreach (var skill in profile.Skills)
                                {
                                    <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Tag : "badge bg-secondary")">@skill</span>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (profile.Languages.Count > 0)
                {
                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Widget : "card shadow-sm mt-3")">
                        <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "card-body")">
                            <h5 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.WidgetTitle : "card-title")">Languages</h5>
                            <ul class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "list-unstyled mb-0")">
                                @foreach (var lang in profile.Languages)
                                {
                                    <li>
                                        @lang.Name
                                        @if (!string.IsNullOrEmpty(lang.Proficiency))
                                        {
                                            <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-muted small")">— @lang.Proficiency</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                @if (profile.Interests.Count > 0)
                {
                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Widget : "card shadow-sm mt-3")">
                        <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "card-body")">
                            <h5 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.WidgetTitle : "card-title")">Interests</h5>
                            <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "d-flex flex-wrap gap-1")">
                                @foreach (var interest in profile.Interests)
                                {
                                    <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Tag : "badge bg-info text-dark")">@interest</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="@Cls.Main">
                @if (!string.IsNullOrEmpty(profile.Bio))
                {
                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Card : "card shadow-sm mb-4")">
                        <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.CardBody : "card-body")">
                            <h5 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.WidgetTitle : "card-title")">About</h5>
                            <div>@((MarkupString)profile.Bio)</div>
                        </div>
                    </div>
                }

                @if (profile.Certifications.Count > 0)
                {
                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Card : "card shadow-sm mb-4")">
                        <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.CardBody : "card-body")">
                            <h5 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.WidgetTitle : "card-title")">Certifications</h5>
                            @foreach (var cert in profile.Certifications)
                            {
                                <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "border-bottom py-2")">
                                    <strong>@cert.Name</strong>
                                    @if (!string.IsNullOrEmpty(cert.IssuingOrganization))
                                    {
                                        <br /><span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-muted small")">@cert.IssuingOrganization</span>
                                    }
                                    @if (cert.IssueDate.HasValue)
                                    {
                                        <br /><span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-muted small")">
                                            Issued @cert.IssueDate.Value.ToString("MMM yyyy")
                                            @if (cert.ExpirationDate.HasValue)
                                            {
                                                <span> · Expires @cert.ExpirationDate.Value.ToString("MMM yyyy")</span>
                                            }
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(cert.CredentialUrl))
                                    {
                                        <br />
                                        <a href="@cert.CredentialUrl" target="_blank" rel="noopener noreferrer"
                                           class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "small text-decoration-none")">
                                            View credential
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (profile.Education.Count > 0)
                {
                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Card : "card shadow-sm mb-4")">
                        <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.CardBody : "card-body")">
                            <h5 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.WidgetTitle : "card-title")">Education</h5>
                            @foreach (var edu in profile.Education)
                            {
                                <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "border-bottom py-2")">
                                    <strong>@edu.Institution</strong>
                                    @if (!string.IsNullOrEmpty(edu.Degree) || !string.IsNullOrEmpty(edu.FieldOfStudy))
                                    {
                                        <br /><span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-muted small")">
                                            @edu.Degree
                                            @if (!string.IsNullOrEmpty(edu.Degree) && !string.IsNullOrEmpty(edu.FieldOfStudy))
                                            {
                                                <span>, </span>
                                            }
                                            @edu.FieldOfStudy
                                        </span>
                                    }
                                    @if (edu.StartDate.HasValue)
                                    {
                                        <br /><span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-muted small")">
                                            @edu.StartDate.Value.ToString("yyyy")
                                            @if (edu.EndDate.HasValue)
                                            {
                                                <span> – @edu.EndDate.Value.ToString("yyyy")</span>
                                            }
                                            else
                                            {
                                                <span> – Present</span>
                                            }
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (profile.RecentPosts.Count > 0)
                {
                    <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.Card : "card shadow-sm mb-4")">
                        <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.CardBody : "card-body")">
                            <h5 class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? Cls.WidgetTitle : "card-title")">Recent Posts</h5>
                            @foreach (var post in profile.RecentPosts)
                            {
                                <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "border-bottom py-2")">
                                    <a href="@PostnomicRouteBuilder.BuildPost(BasePath, RouteStyle, Language, post.Slug)" class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-decoration-none fw-bold")">
                                        @post.Title
                                    </a>
                                    <br />
                                    <span class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-muted small")">@post.PublishedAt.ToString("MMMM dd, yyyy")</span>
                                    @if (!string.IsNullOrEmpty(post.Excerpt))
                                    {
                                        <p class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-muted small mt-1 mb-0")">@post.Excerpt</p>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "mb-3")">
                    <a href="@PostnomicRouteBuilder.BuildIndex(BasePath, RouteStyle, Language)" class="@(MarkupStyle == PostnomicMarkupStyle.Semantic ? "" : "text-decoration-none")">
                        ← Back to blog
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string AuthorSlug { get; set; } = "";

    /// <summary>
    /// Optional ISO-639-1 language code (e.g. "de") for generating language-aware links back to
    /// the blog and to recent posts. The author-profile endpoint has no language argument, so
    /// this is not forwarded to <see cref="IPostnomicBlogService.GetAuthorProfileAsync"/> — it
    /// only affects link generation via <see cref="PostnomicRouteBuilder"/>. The host application
    /// supplies this from its own route (e.g. <c>/blog/{Language}/author/{AuthorSlug}</c>).
    /// </summary>
    [Parameter]
    public string? Language { get; set; }

    private PostnomicAuthorProfile? profile;

    [CascadingParameter]
    private PostnomicBlogContext? BlogContext { get; set; }

    private IPostnomicBlogService BlogService => BlogContext?.BlogService ?? _injectedBlogService;
    private string BasePath => BlogContext?.Options.BasePath ?? _injectedClientOptions.Value.BasePath;

    /// <summary>
    /// The <see cref="PostnomicLanguageRouteStyle"/> configured for this blog. Used together with
    /// <see cref="BasePath"/> and <see cref="Language"/> by <see cref="PostnomicRouteBuilder"/> to
    /// generate correct links regardless of style.
    /// </summary>
    private PostnomicLanguageRouteStyle RouteStyle => BlogContext?.Options.LanguageRouteStyle
        ?? _injectedClientOptions.Value.LanguageRouteStyle;

    private PostnomicMarkupStyle MarkupStyle =>
        BlogContext?.Options.MarkupStyle ?? _injectedClientOptions.Value.MarkupStyle;
    private PostnomicCssClasses Cls => new(MarkupStyle);

    private MarkupString Icon(string bootstrapIconClass) => (MarkupString)(
        MarkupStyle == PostnomicMarkupStyle.Semantic
            ? PostnomicIcons.Markup(bootstrapIconClass)
            : $"<i class=\"{bootstrapIconClass}\"></i>");

    /// <summary>The SEO data for this author, or <see langword="null"/> until the profile has loaded.</summary>
    private PostnomicSeoModel? Seo => profile is null
        ? null
        : PostnomicSeoBuilder.ForAuthor(Navigation.BaseUri, BasePath, RouteStyle, Language, AuthorSlug, profile);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await BlogService.GetAuthorProfileAsync(AuthorSlug);
        }
        catch
        {
            profile = null;
        }
    }
}
