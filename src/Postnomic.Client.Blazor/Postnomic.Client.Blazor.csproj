<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet package metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>Postnomic.Client.Blazor</PackageId>
    <Title>Postnomic Client Blazor</Title>
    <Description>Blazor components for embedding a Postnomic blog. The blog URL is configurable via PostnomicClientOptions.BasePath (default: /blog).</Description>
    <PackageTags>postnomic;blog;cms;client;blazor</PackageTags>

    <!-- wwwroot/.gitkeep only exists to keep the content root directory tracked in git;
         it must never become a static web asset (dotnet pack excludes dotfiles from the
         nupkg by default, which would leave the asset referenced-but-absent and break
         consumers' publish with MSB3030). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);wwwroot\.gitkeep</DefaultItemExcludes>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Postnomic.Client\Postnomic.Client.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Postnomic.Client.Blazor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\postnomic-blog.css" Link="wwwroot\postnomic-blog.css" />
  </ItemGroup>

</Project>
